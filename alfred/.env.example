# ── Chaves de API ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_...sua_chave_aqui...

# ── Autenticação do Alfred (token pessoal, gerado por você) ───────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ALFRED_TOKEN=

# ── Modelos LLM ───────────────────────────────────────────────────
GROQ_MODEL=groq/llama-3.3-70b-versatile
OLLAMA_MODEL=ollama/qwen2.5-coder:3b
OLLAMA_BASE_URL=http://localhost:11434

# ── Rate limit (requisições por minuto) ───────────────────────────
RATE_LIMIT_RPM=30

# ── Frontend (se ALFRED_TOKEN definido acima, copiar aqui também) ─
VITE_ALFRED_TOKEN=
