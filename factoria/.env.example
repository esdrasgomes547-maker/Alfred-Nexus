# =========================================================
#  FactorIA — variáveis de ambiente
#  Copie para .env e preencha. NUNCA commite o .env real.
# =========================================================

# Backend
PORT=4000
NODE_ENV=development

# Banco (SQLite — caminho relativo à pasta backend/)
DATABASE_URL="file:./factoria.db"

# LLM (cérebro dos bots — Groq por padrão)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Opcional: Anthropic Claude (se preenchido, tem prioridade)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Criptografia (chave de 32 caracteres para dados sensíveis)
CRYPTO_SECRET=troque-por-uma-chave-de-32-chars!

# Autenticação (JWT). Se vazio, deriva do CRYPTO_SECRET.
# Em produção, defina um segredo próprio e forte.
JWT_SECRET=
JWT_EXPIRES=7d

# Admin inicial para `npm run seed` (bootstrap não-interativo / headless).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Humanização das respostas (presença "digitando"). Use "off" pra desativar.
HUMANIZE=on
