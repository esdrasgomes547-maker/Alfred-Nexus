// Prisma schema — FactorIA
// Banco: SQLite (self-hosted, sem infraestrutura extra)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Operadores da plataforma (login no painel FactorIA).
// role: 'admin' (tudo) | 'operator' (opera bots) | 'viewer' (só leitura)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String
  role         String   @default("operator")
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Um bot = uma sessão de WhatsApp isolada num container WAHA
model Bot {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  // Porta do container WAHA deste bot (4100, 4101, ...)
  wahaPort      Int      @unique
  wahaContainer String?
  // Liga/desliga via WhatsApp — vem do banco pra sobreviver a restarts
  active        Boolean  @default(false)
  // Comandos de ativação configuráveis por bot (pendência #2 do handoff)
  cmdOn         String   @default("@lev")
  cmdOff        String   @default("@levoff")
  // System prompt do cérebro (vazio = usa o padrão do brain.js)
  prompt        String   @default("")
  skills        Skill[]
  logs          Log[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Chave de API para integrações externas (gateway /v1).
// O segredo nunca é guardado em texto — só o hash sha256 e um prefixo visível.
model ApiKey {
  id         String   @id @default(uuid())
  label      String
  prefix     String   @unique   // ex.: "fct_a1b2c3d4" — usado pra localizar a chave
  keyHash    String              // sha256 hex da chave completa
  botId      String?             // escopo: null = todos os bots
  scopes     String   @default("send,read,chat")
  active     Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
}

// Endpoint que recebe eventos do FactorIA (webhooks de saída).
// Permite plugar CRM/n8n/sistema do cliente no fluxo das mensagens.
model WebhookEndpoint {
  id        String   @id @default(uuid())
  botId     String?            // null = eventos de todos os bots
  url       String
  secret    String             // assina o payload via HMAC-SHA256
  events    String   @default("message.in,message.out,handoff")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Habilidades do bot: gatilho → resposta fixa (skill simples sem LLM)
model Skill {
  id        String   @id @default(uuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  name      String
  trigger   String
  response  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Histórico de mensagens trocadas (entrada + saída)
model Log {
  id        String   @id @default(uuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  phone     String
  direction String   // 'in' | 'out'
  body      String
  createdAt DateTime @default(now())
}
